---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-20 flex flex-col items-start gap-10">
    <div class="w-full">
        <h1 class="font-['Montserrat'] text-[80px] md:text-[120px] leading-[0.9] font-black uppercase mb-4">
            CREATIVE<br/>DEVELOPER
        </h1>
        <div class="inline-block bg-pastel-green-bright border-4 border-black p-6 shadow-brutal-lg mb-10 max-w-2xl">
            <p class="font-['Montserrat'] text-2xl md:text-3xl font-extrabold leading-tight">
                {t('hero.desc').split('PLANTHIA')[0]} 
                <span class="bg-black text-white px-2">PLANTHIA</span> 
                {t('hero.desc').split('PLANTHIA')[1]}
            </p>
        </div>
    </div>
    <div class="flex gap-6 flex-wrap">
        <!-- <button class="bg-pastel-pink font-['Montserrat'] text-xl font-black uppercase border-4 border-black px-10 py-6 shadow-brutal active:translate-x-2 active:translate-y-2 active:shadow-none transition-all">
            {t('hero.contact')}
        </button> -->
        <a 
        href="#contact" 
        class="bg-pastel-pink font-['Montserrat'] text-xl font-black uppercase border-4 border-black px-10 py-6 shadow-brutal hover:translate-x-2 hover:translate-y-2 hover:shadow-none active:scale-95 transition-all inline-block"
    >
        {t('hero.contact')}
    </a>
        <div class="flex items-center gap-2 px-6 border-4 border-black bg-white font-['JetBrains_Mono'] font-bold italic shadow-brutal">
            <span class="material-symbols-outlined text-pastel-yellow-gold" 
            style="
            font-variation-settings: 'FILL' 1; 
            paint-order: markers stroke fill;
            -webkit-text-stroke: 1.5px black;
            filter: drop-shadow(1px 1px 0px black);"
            >bolt</span>
            {t('hero.available')}
        </div>
    </div>
</section>