---
// src/components/Contact.astro
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const content = {
  es: {
    title: "¡Trabajemos juntos!",
    subtitle: "¿Listo para crear algo increíble? Conversemos.",
    labelName: "Nombre",
    phName: "TU NOMBRE",
    labelEmail: "Email",
    phEmail: "TU EMAIL",
    labelMessage: "Mensaje",
    phMessage: "¿QUÉ TENÉS EN MENTE?",
    btnSend: "ENVIAR",
    btnSending: "ENVIANDO...",
    successMsg: "¡Mensaje enviado con éxito!",
    errorMsg: "Hubo un error :( <br/> ¡Intentá de nuevo!"
  },
  en: {
    title: "Let's work together!",
    subtitle: "Ready to build something amazing? Let's talk.",
    labelName: "Name",
    phName: "YOUR NAME",
    labelEmail: "Email",
    phEmail: "YOUR EMAIL",
    labelMessage: "Message",
    phMessage: "WHAT DO YOU HAVE IN MIND?",
    btnSend: "SEND",
    btnSending: "SENDING...",
    successMsg: "Message sent successfully!",
    errorMsg: "Something went wrong :( <br/> Try again!"
  }
};

const { 
  title, 
  subtitle, 
  labelName, 
  phName, 
  labelEmail, 
  phEmail, 
  labelMessage, 
  phMessage, 
  btnSend,
  btnSending,
  successMsg,
  errorMsg 
} = content[lang] || content.es;
---

<section class="py-20 mt-20 text-center relative scroll-mt-16" id="contact">
  <div class="max-w-3xl mx-auto border-4 border-black p-6 md:p-10 bg-pastel-lavender shadow-brutal-xl">
    <h2 class="font-['Montserrat'] text-3xl md:text-5xl font-black uppercase mb-4">
      {title}
    </h2>
    <p class="text-xl font-bold mb-10">
      {subtitle}
    </p>

    <form id="contact-form" class="space-y-6 text-left">
      <div class="flex flex-col gap-2">
        <label class="font-['Montserrat'] font-black uppercase text:lg md:text-xl">{labelName}</label>
        <input
          name="name"
          class="bg-white border-4 border-black p-4 font-bold focus:bg-pastel-pink-pale outline-none transition-all shadow-brutal-sm"
          placeholder={phName}
          type="text"
          required
        />
      </div>
      <div class="flex flex-col gap-2">
        <label class="font-['Montserrat'] font-black uppercase text:lg md:text-xl">{labelEmail}</label>
        <input
          name="email"
          class="bg-white border-4 border-black p-4 font-bold focus:bg-pastel-pink-pale outline-none transition-all shadow-brutal-sm"
          placeholder={phEmail}
          type="email"
          required
        />
      </div>
      <div class="flex flex-col gap-2">
        <label class="font-['Montserrat'] font-black uppercase text:lg md:text-xl">{labelMessage}</label>
        <textarea
          name="message"
          class="bg-white border-4 border-black p-4 font-bold focus:bg-pastel-pink-pale outline-none transition-all shadow-brutal-sm"
          placeholder={phMessage}
          rows="4"
          required
        ></textarea>
      </div>
      <button
        id="submit-btn"
        class="w-full bg-[#000] font-['Montserrat'] text-lg md:text-2xl font-black text-white uppercase border-4 border-black py-6 shadow-brutal hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all disabled:opacity-50 disabled:cursor-not-allowed"
        type="submit"
        data-send={btnSend}
        data-sending={btnSending}
      >
        {btnSend}
      </button>
    </form>
  </div>

  <div id="form-success" class="hidden fixed bottom-6 right-6 md:bottom-10 md:right-10 z-50 bg-[#90EE90] border-4 border-black p-5 font-['Montserrat'] font-black uppercase text-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-all max-w-sm text-left">
    <div class="flex items-center gap-3">
      <span set:html={successMsg}></span>
    </div>
  </div>

  <div id="form-error" class="hidden fixed bottom-6 right-6 md:bottom-10 md:right-10 z-50 bg-[#FF69B4] border-4 border-black p-5 font-['Montserrat'] font-black uppercase text-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-all max-w-sm text-left">
    <div class="flex items-center gap-3">
      <span set:html={errorMsg}></span>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successDiv = document.getElementById('form-success') as HTMLDivElement;
  const errorDiv = document.getElementById('form-error') as HTMLDivElement;

  function showToast(element: HTMLDivElement) {
    element.classList.remove('hidden');
    
    setTimeout(() => {
      element.classList.add('hidden');
    }, 4000);
  }

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      successDiv.classList.add('hidden');
      errorDiv.classList.add('hidden');

      submitBtn.disabled = true;
      submitBtn.innerText = submitBtn.getAttribute('data-sending') || 'ENVIANDO...';

      const formData = new FormData(form);

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showToast(successDiv);
          form.reset();
        } else {
          showToast(errorDiv);
        }
      } catch (error) {
        showToast(errorDiv);
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = submitBtn.getAttribute('data-send') || 'ENVIAR';
      }
    });
  }
</script>