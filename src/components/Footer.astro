---
// src/components/Footer.astro
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const content = {
  es: { builtWith: "Creado con" },
  en: { builtWith: "Built with" }
};

const { builtWith } = content[lang] || content.es;
---

<footer class="w-full py-10 px-6 md:px-16 flex flex-col md:flex-row justify-between items-center gap-4 bg-black text-white border-t-8 border-pastel-magenta mt-20">
  <div class="font-['Montserrat'] text-2xl font-black text-pastel-magenta">
    polinacodes
  </div>
  <div class="flex gap-8 font-['JetBrains_Mono'] font-bold">
    <a class="hover:text-pastel-yellow-pale transition-colors" href="https://github.com/polinacodes" target="_blank" rel="noopener noreferrer">GITHUB</a>
    <a class="hover:text-pastel-yellow-pale transition-colors" href="https://linkedin.com/in/..." target="_blank" rel="noopener noreferrer">LINKEDIN</a>
  </div>
  <div class="italic text-sm">© 2026. {builtWith} Astro.</div>
</footer>