---
// src/components/Footer.astro
import { getLangFromUrl } from "../i18n/utils";
import GitHubIcon from "../icons/GitHub.astro";
import LinkedInIcon from "../icons/LinkedIn.astro";
import InstagramIcon from "../icons/Instagram.astro"; // Tu nuevo icono

const lang = getLangFromUrl(Astro.url);

const content = {
  es: { builtWith: "Creado con" },
  en: { builtWith: "Built with" }
};

const { builtWith } = content[lang] || content.es;
---

<footer class="w-full bg-black text-white border-t-8 border-pastel-magenta mt-20">
  {/* Contenedor interno */}
  <div class="max-w-[1280px] mx-auto py-10 px-6 md:px-16 flex flex-col md:flex-row justify-between items-center gap-6">
    
    <div class="font-['Montserrat'] text-2xl font-black text-pastel-magenta">
      polinacodes
    </div>
    
    {/* Contenedor de Iconos */}
    <div class="flex gap-6 items-center text-pastel-pink-pale">
      <a 
        class="hover:text-pastel-magenta hover:scale-120 transition-all duration-200 block w-6 h-6" 
        href="https://github.com/polinacodes" 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <GitHubIcon />
      </a>
      
      <a 
        class="hover:text-pastel-magenta hover:scale-120 transition-all duration-200 block w-6 h-6" 
        href="https://linkedin.com/in/polinacodes" 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="LinkedIn"
      >
        <LinkedInIcon />
      </a>

      <a 
        class="hover:text-pastel-magenta hover:scale-120 transition-all duration-200 block w-6 h-6" 
        href="https://instagram.com/polinacodes" 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="Instagram"
      >
        <InstagramIcon />
      </a>
    </div>
    
    <div class="italic text-pastel-pink-pale text-sm">© 2026. {builtWith} Astro.</div>
    
  </div>
</footer>