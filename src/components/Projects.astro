        image: "/public/projects/planthia.webp",
        gallery: ["/projects/planthia.webp", "/projects/planthia-2.webp"], 
        alt: "Panel de control de Planthia ecommerce",
        align: "left",
        bgColor: "bg-[#B5D2AD]",
        hoverBtnClass: "hover:bg-secondary-container hover:text-on-background",
