const { title, viewProject, codeBtn, siteBtn, projects } = content[lang] || content.es;
---

<section class="py-stack-lg md:mb-30" id="work">
  <h2 class="font-['Montserrat'] text-5xl font-black uppercase mb-12 border-b-8 border-black inline-block">
    {title}
  </h2>
  
  <div class="flex flex-col gap-16">
    {projects.map((project) => (
      <div class="relative group">
        
        {/* Contenedor de la Imagen / Fondo del Proyecto */}
        <div class="w-full bg-black border-4 border-black overflow-hidden aspect-[16/7] md:aspect-[16/10] lg:aspect-[16/7] md:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">
          <img 
            class="w-full h-full object-cover opacity-90 group-hover:scale-105 transition-transform duration-700" 
            alt={project.alt} 
            src={project.image}
            loading="lazy"
          />
        </div>

        {/* Tarjeta Flotante Informativa */}
        <div class={`
          md:absolute md:bottom-6 
          ${project.align === 'left' ? 'md:left-6' : 'md:right-6'} 
          md:max-w-md w-full ${project.bgColor} border-4 border-black p-6 mt-1 md:mt-0
        `}>
          <div class="bg-black text-white px-3 py-1 inline-block font-['JetBrains_Mono'] text-xs font-bold mb-3 uppercase tracking-wider">
            {project.category}
          </div>
          
          <h3 class="font-['Montserrat'] text-2xl font-black uppercase mb-2 text-black">
            {project.title}
          </h3>
          
          <p class="font-sans text-sm font-medium text-black/80 mb-4 leading-relaxed">
            {project.description}
          </p>
          
          {/* Tags de Tecnologías */}
          <div class="flex flex-wrap gap-2 mb-6">
            {project.tags.map((tag) => (
              <span class="px-2 py-0.5 bg-white border-2 border-black font-['JetBrains_Mono'] font-bold text-[11px] text-black">
                {tag}
              </span>
            ))}
          </div>
          
          {/* Botón de Acción */}
          <button data-open-modal={project.id} class={`w-full flex items-center justify-center gap-2 bg-black text-white font-['Montserrat'] font-black text-lg uppercase border-4 border-black py-3 transition-colors ${project.hoverBtnClass}`}>
            {viewProject} <span class="material-symbols-outlined text-xl">arrow_forward</span>
          </button>
        </div>

      </div>
    ))}
  </div>
</section>

<ProjectModal projects={projects} codeBtn={codeBtn} siteBtn={siteBtn} />