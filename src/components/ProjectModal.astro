---
import GithubIcon from "../icons/GitHub.astro";
import WebsiteIcon from "../icons/WebSite.astro";

interface Props {
  projects: any[];
  codeBtn: string;
  siteBtn: string;
}

const { projects, codeBtn, siteBtn } = Astro.props;
---

<dialog id="project-modal" class="backdrop:bg-black/80 backdrop:backdrop-blur-sm p-4 bg-transparent max-w-5xl 2xl:max-w-7xl  w-full fixed inset-0 m-auto max-h-[95vh] overflow-y-auto md:overflow-visible focus:outline-none">
  <div class="w-full bg-white border-4 border-black shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] relative flex flex-col my-auto">
    
    <button id="close-modal-btn" class="absolute -top-4 -right-4 md:-top-6 md:-right-6 bg-[#FF8A8A] text-black border-4 border-black font-['Montserrat'] font-black text-xl w-10 h-10 md:w-12 md:h-12 flex items-center justify-center hover:bg-red-500 transition-colors z-50 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:translate-x-1 active:translate-y-1 active:shadow-none">
      ✕
    </button>

    <div class="grid grid-cols-1 md:grid-cols-12">
      
      <div class="md:col-span-6 p-6 border-b-4 md:border-b-0 md:border-r-4 border-black flex flex-col justify-between bg-zinc-50">
        <div>
          <div class="w-full aspect-[4/3] bg-black border-4 border-black overflow-hidden mb-4">
            <img id="modal-main-img" src="" alt="" class="w-full h-full object-cover" />
          </div>
          
          <div id="modal-thumbnails" class="flex gap-2 overflow-x-auto pb-2 scrollbar-custom">
          </div>
        </div>

        <div class="mt-6">
          <div id="modal-tags" class="flex flex-wrap gap-2">
          </div>
        </div>
      </div>

      <div class="md:col-span-6 p-6 flex flex-col justify-between bg-white">
        <div class="flex flex-col">
          <div id="modal-category" class="bg-black text-white px-3 py-1 inline-block font-['JetBrains_Mono'] text-xs font-bold mb-3 uppercase tracking-wider self-start">
          </div>
          
          <h3 id="modal-title" class="font-['Montserrat'] text-3xl font-black uppercase mb-4 text-black leading-tight">
          </h3>
          
          <div class="max-h-40 md:max-h-60 2xl:max-h-[300px] overflow-y-auto pr-2 mb-6 scrollbar-custom">
            <p id="modal-long-description" class="font-sans text-sm font-medium text-black/80 leading-relaxed">
            </p>
          </div>
        </div>

        <div class="flex gap-4 pt-4 border-t-4 border-black">
          <a id="modal-code-link" href="" target="_blank" class="flex-1 flex items-center justify-center gap-2 bg-pastel-teal text-black border-4 border-black font-['Montserrat'] font-black text-sm uppercase py-3 hover:bg-black hover:text-white transition-colors">
            <div class="w-5 h-5"><GithubIcon /></div> {codeBtn}
          </a>
          <a id="modal-live-link" href="" target="_blank" class="flex-1 flex items-center justify-center gap-2 bg-pastel-light-indigo text-black border-4 border-black font-['Montserrat'] font-black text-sm uppercase py-3 hover:bg-black hover:text-white transition-colors">
            <div class="w-5 h-5"><WebsiteIcon /></div> {siteBtn}
          </a>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  .scrollbar-custom::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  .scrollbar-custom::-webkit-scrollbar-track {
    background: #000;
  }
  .scrollbar-custom::-webkit-scrollbar-thumb {
    background: #A7DBD8;
    border: 2px solid #000;
  }
</style>

<script define:vars={{ projects }}>
  const modal = document.getElementById('project-modal');
  const closeBtn = document.getElementById('close-modal-btn');
  const openButtons = document.querySelectorAll('[data-open-modal]');

  const mTitle = document.getElementById('modal-title');
  const mCategory = document.getElementById('modal-category');
  const mLongDesc = document.getElementById('modal-long-description');
  const mMainImg = document.getElementById('modal-main-img');
  const mThumbnails = document.getElementById('modal-thumbnails');
  const mTags = document.getElementById('modal-tags');
  const mCodeLink = document.getElementById('modal-code-link');
  const mLiveLink = document.getElementById('modal-live-link');

  openButtons.forEach(button => {
    button.addEventListener('click', () => {
      const projectId = button.getAttribute('data-open-modal');
      const project = projects.find(p => p.id === projectId);

      if (!project) return;

      mTitle.textContent = project.title;
      mCategory.textContent = project.category;
      mLongDesc.textContent = project.longDescription || project.description;
      mMainImg.src = project.gallery?.[0] || project.image;
      
      if (project.github) {
        mCodeLink.style.display = 'flex';
        mCodeLink.onclick = (e) => {
          e.preventDefault(); 
          window.open(project.github, '_blank', 'noopener,noreferrer');
        };
      } else {
        mCodeLink.style.display = 'none';
        mCodeLink.onclick = null;
      }

      if (project.live) {
        mLiveLink.style.display = 'flex';
        mLiveLink.onclick = (e) => {
          e.preventDefault(); 
          window.open(project.live, '_blank', 'noopener,noreferrer');
        };
      } else {
        mLiveLink.style.display = 'none';
        mLiveLink.onclick = null;
      }

      mThumbnails.innerHTML = '';
      if (project.gallery?.length > 1) {
        project.gallery.forEach((img, idx) => {
          const btn = document.createElement('button');
          btn.className = `w-16 h-12 border-2 border-black flex-shrink-0 ${idx === 0 ? 'opacity-100 ring-2 ring-black' : 'opacity-50'}`;
          btn.innerHTML = `<img src="${img}" class="w-full h-full object-cover">`;
          btn.onclick = () => {
            mMainImg.src = img;
            mThumbnails.querySelectorAll('button').forEach(b => b.classList.add('opacity-50'));
            btn.classList.remove('opacity-50');
          };
          mThumbnails.appendChild(btn);
        });
      }

      mTags.innerHTML = '';
      project.tags.forEach(tag => {
        const span = document.createElement('span');
        span.className = "px-2 py-0.5 bg-white border-2 border-black font-['JetBrains_Mono'] font-bold text-[10px] text-black";
        span.textContent = tag;
        mTags.appendChild(span);
      });

      modal.showModal();
    });
  });

  closeBtn.onclick = () => modal.close();
  modal.onclick = (e) => e.target === modal && modal.close();
</script>