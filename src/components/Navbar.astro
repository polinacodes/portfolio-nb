---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import MobileMenu from './MobileMenu.jsx';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const switchTarget = lang === 'es' ? '/en/' : '/';
const switchLabel = lang === 'es' ? 'EN' : 'ES';

const translations = {
  about: t('nav.about'),
  skills: t('nav.skills'),
  projects: t('nav.projects'),
  contact: t('nav.contact')
};
---

<!-- <header class="sticky top-0 z-50 flex justify-between items-center w-full px-6 lg:px-16 py-4 max-w-[1280px] mx-auto bg-white border-b-4 border-x-4 border-black shadow-brutal"> -->
<header class="sticky top-0 z-50 flex justify-between items-center w-full px-6 md:px-16 py-4 max-w-[1280px] mx-auto bg-white border-b-4 border-black shadow-brutal ">
    <a href="#" class="font-['Montserrat'] text-2xl font-black tracking-tighter text-black hover:opacity-80 transition-opacity no-underline">
      polinacodes
    </a>
    
    <nav class="hidden lg:flex gap-8 items-center">
        <a class="font-['Montserrat'] text-lg uppercase font-black hover:bg-pastel-teal transition-all px-2" href="#about">{t('nav.about')}</a>
        <a class="font-['Montserrat'] text-lg uppercase font-black hover:bg-pastel-light-indigo transition-all px-2" href="#skills">{t('nav.skills')}</a>
        <a class="font-['Montserrat'] text-lg uppercase font-black hover:bg-pastel-yellow-secondary transition-all px-2" href="#work">{t('nav.projects')}</a>
        <a class="font-['Montserrat'] text-lg uppercase font-black hover:bg-pastel-pink transition-all px-2" href="#contact">{t('nav.contact')}</a>

        <a href={switchTarget} class="ml-4 border-2 border-black px-2 py-1 font-black hover:bg-black hover:text-white transition-all text-sm">
            {switchLabel}
        </a>
    </nav>

    <div class="lg:hidden">
        <MobileMenu 
            client:load 
            t={translations} 
            switchTarget={switchTarget} 
            switchLabel={switchLabel} 
        />
    </div>
</header>