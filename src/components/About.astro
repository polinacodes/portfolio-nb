---
import { getLangFromUrl } from "../i18n/utils";
import StarSection from "../icons/StarSection.jsx";

const lang = getLangFromUrl(Astro.url);
const content = {
  es: {
    title: "Sobre mí",
    description:
      "Soy desarrolladora Full Stack y me gusta trabajar en los dos lados de una aplicación: de la base de datos y la API a la interfaz. Desarrollo con React, Next.js y TypeScript en el frontend, y con Node.js, Express y PostgreSQL en el backend, cuidando tanto el rendimiento y la seguridad como el detalle visual. Mi proyecto más reciente es Nailary, un sistema de turnos en producción que desarrollé de punta a punta.",
  },
  en: {
    title: "About me",
    description:
      "I'm a Full Stack developer who enjoys working on both sides of an application, from the database and API to the interface. I build with React, Next.js, and TypeScript on the frontend, and Node.js, Express, and PostgreSQL on the backend, caring as much about performance and security as visual detail. My latest project is Nailary, a booking system in production that I built end to end.",
  },
};
const { title, description } = content[lang] || content.es;
---

<section class="mt-24 py-0 md:py-20 scroll-mt-24" id="about">
  <div class="flex items-center gap-3 mb-8">
    <StarSection
      client:visible
      fillColor="#FF69B4"
      className="flex-shrink-0 w-12 h-12 md:w-16 md:h-16"
    />

    <h2
      class="font-['Montserrat'] text-4xl md:text-5xl font-black uppercase border-b-8 border-black inline-block m-0"
    >
      {title}
    </h2>
  </div>

  <div class="bg-pastel-teal border-4 border-black shadow-brutal-lg p-10">
    <p class="text-xl md:text-2xl font-medium max-w-4xl leading-relaxed">
      {description}
    </p>
  </div>
</section>
