---
// src/pages/en/index.astro
import "../../styles/global.css"; 
export const prerender = true;
import montserrat800 from "@fontsource/montserrat/files/montserrat-latin-800-normal.woff2?url";
import montserrat900 from "@fontsource/montserrat/files/montserrat-latin-900-normal.woff2?url";
import Navbar from "../../components/Navbar.astro";
import Hero from "../../components/Hero.astro";
import About from "../../components/About.astro";
import Skills from "../../components/Skills.astro";
import Projects from "../../components/Projects.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="description" content="Polinacodes' professional portfolio. Full Stack web developer focused on building fluid, secure, and high-performance applications, always prioritizing visual quality and user experience." />
    <link rel="preload" href={montserrat900} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserrat800} as="font" type="font/woff2" crossorigin />
    <title>{t("head.title")}</title>
  </head>
  
  <body class="min-h-[100dvh] flex flex-col bg-white text-black font-['Geist'] antialiased">
    <Navbar />

    <div class="w-full overflow-x-hidden flex-grow">
      <main class="max-w-[1280px] mx-auto px-6 md:px-16">
        <Hero />
        <About />
        <Skills />
        <Projects />
        <Contact />
      </main>
    </div>

    <Footer />
  </body>
</html>