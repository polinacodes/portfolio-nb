---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@600&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <title>{t("head.title")}</title>
  </head>
  <body class="bg-white text-black font-['Geist'] antialiased">
    <Navbar />

    <main class="max-w-[1280px] mx-auto px-6 md:px-16">
      <Hero />
      <About />

      <section class="py-20" id="skills">
        <div class="flex flex-col md:flex-row gap-12">
          <div class="md:w-1/3">
            <h2
              class="font-['Montserrat'] text-5xl font-black uppercase mb-4 border-b-8 border-black inline-block"
            >
              Skills
            </h2>
            <p class="text-xl font-bold mb-8 italic">
              Mi stack de herramientas favorito para dominar la web.
            </p>
            <div
              class="p-4 bg-black text-white border-4 border-black shadow-brutal"
            >
              <span
                class="font-['JetBrains_Mono'] uppercase tracking-widest text-sm"
                >Learning: Mobile ID & Advanced Security</span
              >
            </div>
          </div>
          <div class="md:w-2/3 grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div
              class="aspect-square bg-white border-4 border-black p-4 flex flex-col items-center justify-center gap-4 shadow-brutal hover:-translate-y-2 transition-all group"
            >
              <span class="material-symbols-outlined text-5xl">terminal</span>
              <span class="font-['JetBrains_Mono'] font-black uppercase"
                >ASTRO</span
              >
            </div>
            <div
              class="aspect-square bg-pastel-teal border-4 border-black p-4 flex flex-col items-center justify-center gap-4 shadow-brutal hover:-translate-y-2 transition-all group"
            >
              <span class="material-symbols-outlined text-5xl"
                >deployed_code</span
              >
              <span class="font-['JetBrains_Mono'] font-black uppercase"
                >NEXT.JS</span
              >
            </div>
            <div
              class="aspect-square bg-white border-4 border-black p-4 flex flex-col items-center justify-center gap-4 shadow-brutal hover:-translate-y-2 transition-all group"
            >
              <span class="material-symbols-outlined text-5xl">database</span>
              <span class="font-['JetBrains_Mono'] font-black uppercase"
                >POSTGRES</span
              >
            </div>
            <div
              class="aspect-square bg-pastel-violet border-4 border-black p-4 flex flex-col items-center justify-center gap-4 shadow-brutal hover:-translate-y-2 transition-all group"
            >
              <span class="material-symbols-outlined text-5xl"
                >settings_ethernet</span
              >
              <span class="font-['JetBrains_Mono'] font-black uppercase"
                >STRAPI</span
              >
            </div>
          </div>
        </div>
      </section>

      <section class="py-20" id="work">
        <h2
          class="font-['Montserrat'] text-5xl font-black uppercase mb-12 border-b-8 border-black inline-block"
        >
          Proyectos
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
          <div
            class="md:col-span-8 bg-pastel-green-bright border-4 border-black shadow-brutal-lg p-10 flex flex-col md:flex-row gap-10"
          >
            <div class="flex-1 space-y-4">
              <div
                class="bg-black text-white px-4 py-1 inline-block font-['JetBrains_Mono']"
              >
                ECOSYSTEM
              </div>
              <h3 class="font-['Montserrat'] text-4xl font-black uppercase">
                Planthia
              </h3>
              <p class="text-lg font-bold">
                Plataforma integral para amantes de las plantas: identificación
                con IA y base de datos masiva.
              </p>
              <div class="flex flex-wrap gap-2 mt-4">
                <span
                  class="px-2 py-1 bg-white border-2 border-black font-black text-xs uppercase"
                  >Astro</span
                >
                <span
                  class="px-2 py-1 bg-white border-2 border-black font-black text-xs uppercase"
                  >PostgreSQL</span
                >
                <span
                  class="px-2 py-1 bg-white border-2 border-black font-black text-xs uppercase"
                  >Mobile App</span
                >
              </div>
            </div>
            <div
              class="w-full md:w-1/3 bg-white border-4 border-black aspect-square flex items-center justify-center relative overflow-hidden group"
            >
              <span
                class="material-symbols-outlined text-8xl group-hover:scale-110 transition-transform"
                >potted_plant</span
              >
            </div>
          </div>
          <div
            class="md:col-span-4 bg-pastel-yellow-warm border-4 border-black shadow-brutal-lg p-10 flex flex-col justify-between"
          >
            <div>
              <div
                class="bg-black text-white px-4 py-1 inline-block font-['JetBrains_Mono'] mb-4"
              >
                E-COMMERCE
              </div>
              <h3 class="font-['Montserrat'] text-3xl font-black uppercase">
                Next.js Shop
              </h3>
              <p class="font-bold">
                Portfolio de tienda escalable con headless CMS.
              </p>
            </div>
            <div class="mt-10 flex justify-between items-end">
              <div
                class="font-['JetBrains_Mono'] font-black border-2 border-black px-2"
              >
                NEXT / STRAPI
              </div>
              <span class="material-symbols-outlined text-4xl"
                >arrow_outward</span
              >
            </div>
          </div>
        </div>
      </section>

      <section class="py-20 text-center" id="contact">
        <div
          class="max-w-3xl mx-auto border-4 border-black p-10 bg-white shadow-brutal-xl"
        >
          <h2 class="font-['Montserrat'] text-5xl font-black uppercase mb-4">
            Let's Build
          </h2>
          <p class="text-xl font-bold mb-10">
            ¿Listo para crear algo increíble? Conversemos.
          </p>
          <form class="space-y-6 text-left">
            <div class="flex flex-col gap-2">
              <label class="font-['Montserrat'] font-black uppercase text-xl"
                >Nombre</label
              >
              <input
                class="bg-white border-4 border-black p-4 font-bold focus:bg-pastel-yellow-pale outline-none transition-all shadow-brutal-sm"
                placeholder="TU NOMBRE"
                type="text"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label class="font-['Montserrat'] font-black uppercase text-xl"
                >Email</label
              >
              <input
                class="bg-white border-4 border-black p-4 font-bold focus:bg-pastel-yellow-pale outline-none transition-all shadow-brutal-sm"
                placeholder="TU EMAIL"
                type="email"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label class="font-['Montserrat'] font-black uppercase text-xl"
                >Mensaje</label
              >
              <textarea
                class="bg-white border-4 border-black p-4 font-bold focus:bg-pastel-pink-pale outline-none transition-all shadow-brutal-sm"
                placeholder="¿QUÉ TIENES EN MENTE?"
                rows="4"></textarea>
            </div>
            <button
              class="w-full bg-pastel-teal font-['Montserrat'] text-2xl font-black uppercase border-4 border-black py-6 shadow-brutal hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all"
              type="submit"
            >
              CONTACTAME
            </button>
          </form>
        </div>
      </section>
    </main>

    <footer
      class="w-full py-10 px-6 md:px-16 flex flex-col md:flex-row justify-between items-center gap-4 bg-black text-white border-t-8 border-pastel-pink mt-20"
    >
      <div class="font-['Montserrat'] text-2xl font-black text-pastel-pink">
        polinacodes
      </div>
      <div class="flex gap-8 font-['JetBrains_Mono'] font-bold">
        <a class="hover:text-pastel-cyan transition-colors" href="#">GITHUB</a>
        <a class="hover:text-pastel-cyan transition-colors" href="#">LINKEDIN</a
        >
      </div>
      <div class="italic text-sm">© 2026. Built with Astro.</div>
    </footer>
  </body>
</html>
