---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@600&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <title>{t("head.title")}</title>
  </head>
  <body class="bg-white text-black font-['Geist'] antialiased">
    <Navbar />

    <main class="max-w-[1280px] mx-auto px-6 md:px-16">
      <Hero />
      
      <About />

      <Skills />

      <Projects />

      <section class="py-20 mt-20 text-center" id="contact">
        <div
          class="max-w-3xl mx-auto border-4 border-black p-6 md:p-10 bg-pastel-lavender shadow-brutal-xl"
        >
          <h2 class="font-['Montserrat'] text-3xl md:text-5xl font-black uppercase mb-4">
            Let's work together!
          </h2>
          <p class="text-xl font-bold mb-10">
            ¿Listo para crear algo increíble? Conversemos.
          </p>
          <form class="space-y-6 text-left">
            <div class="flex flex-col gap-2">
              <label class="font-['Montserrat'] font-black uppercase text:lg md:text-xl"
                >Nombre</label
              >
              <input
                class="bg-white border-4 border-black p-4 font-bold focus:bg-pastel-pink-pale outline-none transition-all shadow-brutal-sm"
                placeholder="TU NOMBRE"
                type="text"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label class="font-['Montserrat'] font-black uppercase text:lg md:text-xl"
                >Email</label
              >
              <input
                class="bg-white border-4 border-black p-4 font-bold focus:bg-pastel-pink-pale outline-none transition-all shadow-brutal-sm"
                placeholder="TU EMAIL"
                type="email"
              />
            </div>
            <div class="flex flex-col gap-2">
              <label class="font-['Montserrat'] font-black uppercase text:lg md:text-xl"
                >Mensaje</label
              >
              <textarea
                class="bg-white border-4 border-black p-4 font-bold focus:bg-pastel-pink-pale outline-none transition-all shadow-brutal-sm"
                placeholder="¿QUÉ TENÉS EN MENTE?"
                rows="4"></textarea>
            </div>
            <button
              class="w-full bg-[#000] font-['Montserrat'] text-lg md:text-2xl font-black text-white uppercase border-4 border-black py-6 shadow-brutal hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all"
              type="submit"
            >
              ENVIAR
            </button>
          </form>
        </div>
      </section>
    </main>

    <footer
      class="w-full  py-10 px-6 md:px-16 flex flex-col md:flex-row justify-between items-center gap-4 bg-black text-white border-t-8 border-pastel-magenta mt-20"
    >
      <div class="font-['Montserrat'] text-2xl font-black text-pastel-magenta">
        polinacodes
      </div>
      <div class="flex gap-8 font-['JetBrains_Mono'] font-bold">
        <a class="hover:text-pastel-yellow-pale transition-colors" href="#">GITHUB</a>
        <a class="hover:text-pastel-yellow-pale transition-colors" href="#">LINKEDIN</a
        >
      </div>
      <div class="italic text-sm">© 2026. Built with Astro.</div>
    </footer>
  </body>
</html>
